# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: (Optional) Base URL for external backend API (e.g. AWS EC2, Elastic Beanstalk, ECS, API Gateway).
# - When deploying both frontend and backend on Vercel:
#   Leave this BLANK or omit it. The included /api serverless functions automatically handle all /api/* requests on the same domain.
# - When deploying backend separately on AWS or another remote server:
#   Configure this in Vercel Project Settings > Environment Variables:
#   VITE_API_URL="https://api.your-aws-backend.com"
# Note: Keep backend secrets (DB passwords, server private keys) in server-side environment variables; do NOT prefix them with VITE_.
VITE_API_URL=""

# POSTGRES_URL / DATABASE_URL: Persistent production database connection string.
# On Vercel: Go to your project dashboard -> Storage -> Create Database -> Postgres (Neon).
# Vercel automatically sets POSTGRES_URL, POSTGRES_PRISMA_URL, and DATABASE_URL in your environment variables.
# When provided, all student registrations, logins, and listings are persisted to this database.
POSTGRES_URL="postgres://user:password@hostname:5432/circuit2circuit?sslmode=require"
DATABASE_URL="postgres://user:password@hostname:5432/circuit2circuit?sslmode=require"

# AUTH_SECRET: Cryptographic signing secret for stateless serverless session tokens.
# Set this in Vercel Project Settings > Environment Variables to any random 32+ character string.
# Ensures student sessions remain authenticated across serverless cold starts and page refreshes.
AUTH_SECRET="c2c_vasavi_autonomous_secret_salt_2026"

