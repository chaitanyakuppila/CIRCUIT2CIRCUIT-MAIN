{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/src/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/uploads/:file*",
      "destination": "/api/uploads/:file*"
    },
    {
      "source": "/((?!api/|uploads/|assets/|src/assets/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
