{
  "entities": {
    "User": {
      "title": "User",
      "description": "Student user profile and authentication credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "rollNumber": { "type": "string" },
        "branch": { "type": "string" },
        "mobile": { "type": "string" },
        "year": { "type": "string" },
        "shareMobilePublicly": { "type": "boolean" },
        "passwordHash": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "rollNumber", "branch", "mobile", "year", "passwordHash"]
    },
    "Listing": {
      "title": "Listing",
      "description": "Lab component listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "data": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "data"]
    },
    "Session": {
      "title": "Session",
      "description": "Active session token",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["token", "userId"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Student in-app chat thread",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "listingId": { "type": "string" },
        "sellerId": { "type": "string" },
        "buyerId": { "type": "string" },
        "lastMessageText": { "type": "string" },
        "lastMessageAt": { "type": "string" }
      },
      "required": ["id", "listingId", "sellerId", "buyerId"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual chat message in a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "conversationId", "senderId", "text", "createdAt"]
    }
  },
  "firestore": {
    "/c2c_users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Student user accounts collection"
    },
    "/c2c_sessions/{token}": {
      "schema": { "$ref": "#/entities/Session" },
      "description": "Session tokens collection"
    },
    "/c2c_listings/{listingId}": {
      "schema": { "$ref": "#/entities/Listing" },
      "description": "Lab component listings collection"
    },
    "/c2c_conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Chat conversations collection"
    },
    "/c2c_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Chat messages collection"
    }
  }
}
