rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    match /c2c_users/{userId} {
      allow read, write: if true;
    }

    match /c2c_sessions/{token} {
      allow read, write: if true;
    }

    match /c2c_listings/{listingId} {
      allow read, write: if true;
    }

    match /c2c_conversations/{conversationId} {
      allow read, write: if true;
    }

    match /c2c_messages/{messageId} {
      allow read, write: if true;
    }

    match /c2c_reports/{reportId} {
      allow read, write: if true;
    }

    match /c2c_requests/{requestId} {
      allow read, write: if true;
    }

    match /c2c_guides/{guideId} {
      allow read, write: if true;
    }

    match /c2c_care_requests/{requestId} {
      allow read, write: if true;
    }

    match /c2c_transactions/{txId} {
      allow read, write: if true;
    }
  }
}
